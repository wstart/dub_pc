[Unit]
Description=AdsPower Taskroom Flask Manager
After=network-online.target adspower-headless.service netfilter-persistent.service
Wants=network-online.target

[Service]
Type=simple
User=adspower
Group=adspower
WorkingDirectory=/opt/adspower-tasks
EnvironmentFile=/etc/adspower-headless.env
EnvironmentFile=/etc/adspower-tasks.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/adspower-tasks/.venv/bin/gunicorn --workers 1 --threads 12 --timeout 180 --bind 0.0.0.0:5088 wsgi:app
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
